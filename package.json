{
  "name": "@sanctuary-ds/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Sanctuary: a design system of stone, glass and light.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "test": "node --test"
  },
  "exports": {
    "./css": "./dist/css/sanctuary.css",
    "./palette": "./dist/palette.json",
    "./tokens/*": "./tokens/*"
  }
}
