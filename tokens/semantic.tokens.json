      "$value": "{glass.ruby.ink}"
    },
    "pane": {
      "$value": "{glass.ruby.pane}"
    },
    "on": {
      "$value": "{glass.ruby.on}"
    },
    "on-pane": {
      "$value": "{glass.ruby.on-pane}"
    }
  },
  "warning": {
