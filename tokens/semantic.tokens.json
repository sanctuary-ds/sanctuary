    "function": {
      "$value": "{glass.azure.$root}"
    },
    "type": {
      "$value": "{glass.gilt.$root}"
    },
    "property": {
      "$value": "{glass.cobalt.$root}"
    },
    "tag": {
      "$value": "{glass.ruby.$root}"
    },
    "operator": {
      "$value": "{glass.viridian.$root}"
    },
    "regex": {
      "$value": "{glass.rose.$root}"
    },
    "variable": {
      "$value": "{text.$root}"
    },
    "punctuation": {
      "$value": "{text.muted}"
    },
    "comment": {
      "$value": "{text.subtle}"
    }
  },
  "window": {
    "$type": "gradient",
    "rosace": {
      "$description": "Ruby against cobalt, the rose window.",
      "$value": [
        {
